build_local_libhipcim_() {
    local source_folder=${1:-${TOP}}
    local build_type=${2:-debug}
    local build_type_str=${3:-Debug}
    local prefix=${4:-}
    local enable_coverage=${5:-OFF}
    local build_folder=${source_folder}/build-${build_type}
    local CMAKE_CMD=${CMAKE_CMD:-cmake}

    pushd ${source_folder} > /dev/null

    export CMAKE_PREFIX_PATH=/opt/rocm/lib/cmake
    export CMAKE_MODULE_PATH=/opt/rocm/lib/cmake

    # If coverage is enabled, ensure both C and C++ use hipcc
    local c_compiler_flag=""
    if [ "${enable_coverage}" = "ON" ]; then
        c_compiler_flag="-DCMAKE_C_COMPILER=hipcc"
    fi

    # Pass --gcc-toolchain to hipcc so it finds the correct libstdc++ headers
    local gcc_toolchain_flag=""
    if [ -n "${GCC_TOOLCHAIN_ROOT:-}" ]; then
        gcc_toolchain_flag="-DCMAKE_CXX_FLAGS=--gcc-toolchain=${GCC_TOOLCHAIN_ROOT}"
    fi

    ${CMAKE_CMD} -S ${source_folder} -B ${build_folder} -G "Unix Makefiles" \
        -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE \
        -DCMAKE_PREFIX_PATH=${prefix} \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_BUILD_TYPE=${build_type_str} \
        -DCMAKE_INSTALL_PREFIX=${source_folder}/install \
        -DCMAKE_PREFIX_PATH=${prefix} \
        -DCMAKE_CXX_COMPILER=hipcc \
        ${c_compiler_flag} \
        ${gcc_toolchain_flag} \
        $(fetchcontent_offline_flag_ ${build_folder}) \
        -DENABLE_CODE_COVERAGE=${enable_coverage} \
        -DGPU_TARGETS=${AMDGPU_TARGETS}
        ${CMAKE_CMD} --build ${build_folder} --config ${build_type_str} --target hipcim -- -j $(nproc)
        ${CMAKE_CMD} --build ${build_folder} --config ${build_type_str} --target install -- -j $(nproc)

    popd
}

build_local_hipslide_() {
    local source_folder=${1:-${TOP}/cpp/plugins/cucim.kit.cuslide}
    local cucim_source_folder=${TOP}
    echo ${cucim_source_folder}
    local build_type=${2:-debug}
    local build_type_str=${3:-Debug}
    local prefix=${4:-}
    local enable_coverage=${5:-OFF}
    local build_folder=${source_folder}/build-${build_type}
    local CMAKE_CMD=${CMAKE_CMD:-cmake}

    pushd ${source_folder} > /dev/null
    export CMAKE_PREFIX_PATH=/opt/rocm/lib/cmake
    export CMAKE_MODULE_PATH=/opt/rocm/lib/cmake

    # Inject LLVM coverage instrumentation (plus any --gcc-toolchain) into
    # CMAKE_CXX_FLAGS. The plugin CMake project does not honor
    # ENABLE_CODE_COVERAGE, so the flags are injected directly here.
    local extra_cmake_args=()
    local cxx_flags=""
    if [ -n "${GCC_TOOLCHAIN_ROOT:-}" ]; then
        cxx_flags="--gcc-toolchain=${GCC_TOOLCHAIN_ROOT}"
    fi
    if [ "${enable_coverage}" = "ON" ]; then
        # Instrument only C++ sources. Do NOT override the C compiler or add C
        # coverage flags: the bundled third-party C libs (e.g. openjpeg) fail to
        # build when forced through hipcc/clang++ (-x c) with coverage flags.
        cxx_flags="${cxx_flags} -fprofile-instr-generate -fcoverage-mapping -g"
    fi
    [ -n "${cxx_flags}" ] && extra_cmake_args+=("-DCMAKE_CXX_FLAGS=${cxx_flags}")

    ${CMAKE_CMD} -S ${source_folder} -B ${build_folder} -G "Unix Makefiles" \
        -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_BUILD_TYPE=${build_type_str} \
        -DCMAKE_PREFIX_PATH=${prefix} \
        -DCMAKE_CXX_COMPILER=hipcc \
        "${extra_cmake_args[@]}" \
        $(fetchcontent_offline_flag_ ${build_folder}) \
        -DGPU_TARGETS=${AMDGPU_TARGETS} \
        -DCMAKE_INSTALL_PREFIX=${cucim_source_folder}/install

    if [ "${enable_coverage}" = "ON" ]; then
        # Build all plugin targets (lib + tests + benchmarks) so the test
        # binaries exist, are instrumented, and can exercise the plugin for
        # coverage; then install so they land in install/{lib,bin}.
        ${CMAKE_CMD} --build ${build_folder} --config ${build_type_str} -- -j $(nproc)
    else
        ${CMAKE_CMD} --build ${build_folder} --config ${build_type_str} --target hipcim.kit.hipslide -- -j $(nproc)
    fi
    ${CMAKE_CMD} --build ${build_folder} --config ${build_type_str} --target install -- -j $(nproc)

    popd
}

