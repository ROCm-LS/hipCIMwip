test_desc() { echo 'Execute test cases

Arguments:
  $1 - subcommand [all|python|cpp] (default: all)
  $2 - test_type [all|unit|integration|system|performance] (default: all)
  $3 - test_component [all|clara|skimage] (default: all)
'
}
test() {
    local subcommand="${1:-all}"
    local test_type="${2:-all}"
    shift;
    if [ "$subcommand" = "all" ] || [ "$subcommand" = "cpp" ]; then
        test_cpp "$@"
    fi

    if [ "$subcommand" = "all" ] || [ "$subcommand" = "python" ]; then
        test_python "$@"
    fi
}

install_python_test_deps_() {
    if [ -n "${CONDA_PREFIX}" ]; then
        # Install test dependencies from pip because conda does not have all the dependencies (e.g., opencv-python).
        # (https://github.com/rapidsai/cucim/pull/433)
        run_command pip install -r ${TOP}/python/cucim/requirements-test.txt
    else
        pushd "${TOP}/python/cucim"
        if [ -n "${VIRTUAL_ENV}" ]; then
            run_command pip3 install -e .[test]
        else
            run_command pip3 install --user -e .[test]
        fi
        popd
    fi
    hash -r
}

test_python_desc() { echo 'Execute Python test cases

Arguments:
  $1 - test_type [all|unit|integration|system|performance] (default: all)
  $2 - test_component [all|clara|skimage] (default: all)
'
}
test_python() {
    local test_type="${1:-all}"
    local test_component="${2:-all}"
    local result=0

    local testsuite=""
    local testsuite_unit_skimage="src"
    local testsuite_unit_clara="tests/unit"
    local testsuite_performance="tests/performance"

    if [ "$test_type" = "all" ] || [ "$test_type" = "unit" ]; then
        local testsuite="${testsuite_unit_skimage} ${testsuite_unit_clara}"
        [ "$test_component" = "skimage" ] && testsuite="${testsuite_unit_skimage}"
        [ "$test_component" = "clara" ] && testsuite="${testsuite_unit_clara}"

    fi
    if [ "$test_type" = "all" ] || [ "$test_type" = "performance" ]; then
        testsuite="${testsuite} ${testsuite_performance}"
    fi

    # When HIPCIM_CPP_PROFILE=ON, capture C++ coverage exercised by the Python
    # suite: pytest drives the compiled extension (cucim/clara/_cucim.so ->
    # libhipcim.so + plugins), so profiling it captures C++ paths the C++ unit
    # tests never reach. We point the import at the in-place build and drop the
    # instrumented core+plugin libs into its clara/ dir so the exercised C++ is
    # the instrumented build (bytes match install/lib, so profiles merge with
    # the C++-test run).
    if [ "${HIPCIM_CPP_PROFILE:-OFF}" = "ON" ]; then
        local _pyroot _clara _core _t _p
        _pyroot="$(ls -d ${TOP}/python/cucim/build/lib.*/ 2>/dev/null | head -1)"
        if [ -n "${_pyroot}" ] && [ -d "${_pyroot}cucim/clara" ]; then
            _clara="${_pyroot}cucim/clara"
            _core="$(ls -1 ${TOP}/install/lib/libhipcim.so.*.*.* 2>/dev/null | head -1)"
            [ -z "${_core}" ] && _core="$(ls -1 ${TOP}/install/lib/libhipcim.so 2>/dev/null | head -1)"
            if [ -n "${_core}" ]; then
                for _t in "${_clara}"/libhipcim.so*; do [ -f "${_t}" ] && cp -f "${_core}" "${_t}"; done
            fi
            for _p in ${TOP}/install/lib/hipcim.kit.*.so; do
                [ -f "${_p}" ] && cp -f "${_p}" "${_clara}/$(basename "${_p}")"
            done
            export PYTHONPATH="${_pyroot}${PYTHONPATH:+:$PYTHONPATH}"
            export LLVM_PROFILE_FILE="${TOP}/py_cov_%p_%9m.profraw"
            rm -f ${TOP}/py_cov_*.profraw
            c_echo G "C++ profiling ON for pytest (PYTHONPATH=${_pyroot}, LLVM_PROFILE_FILE set)"
        else
            c_echo Y "HIPCIM_CPP_PROFILE=ON but no importable build under python/cucim/build/lib.*; C++ profiling skipped"
        fi
    fi

    pushd $TOP/python/cucim
    run_command py.test --cache-clear -vv \
        --cov=cucim \
        --junitxml="$TOP/junit-cucim.xml" \
        --cov-config=$TOP/python/cucim/.coveragerc \
        --cov-report=xml:"$TOP/cucim-coverage.xml" \
        --cov-report term \
        ${testsuite}
    result=$?

    # Generate JSON from the collected coverage data, scoped to changed files
    # if a difflist is available.
    DIFFLIST_PYTHON_FILE="${TOP}/difflist-python.txt"
    if [ -f "${DIFFLIST_PYTHON_FILE}" ] && [ -s "${DIFFLIST_PYTHON_FILE}" ]; then
        INCLUDE_PATTERNS=$(cat "${DIFFLIST_PYTHON_FILE}" | sed 's|^|*/|' | paste -sd ',' -)
        c_echo G "Scoping Python coverage to diff files: ${INCLUDE_PATTERNS}"
        run_command coverage json --ignore-errors \
            --include="${INCLUDE_PATTERNS}" \
            -o "$TOP/hipcim-coverage-python.json"
    else
        c_echo Y "Python diff list absent or empty; reporting full coverage."
        run_command coverage json -o "$TOP/hipcim-coverage-python.json"
    fi

    # Create comparison reports against baseline
    python3 $TOP/scripts/cucim_compare_junit.py                               \
         --baseline "$TOP/test_data/baseline/junit-cucim_latest.xml"          \
         --report "$TOP/junit-cucim.xml"                                      \
         --skip   "$TOP/test_data/baseline/junit-cucim_skiplist_latest.txt"   \
                                        > "$TOP/junit-cucim_report.txt" 2>&1
    info "JUnit comparison report written to \"$TOP/junit-cucim_report.txt\""

    python3 $TOP/scripts/cucim_compare_coverage.py                            \
         --baseline "$TOP/test_data/baseline/cucim-coverage_latest.xml"       \
         --report "$TOP/cucim-coverage.xml"                                   \
                                     > "$TOP/cucim-coverage_report.txt" 2>&1
    info "Coverage comparison report written to \"$TOP/cucim-coverage_report.txt\""

    popd

    return $result
}

